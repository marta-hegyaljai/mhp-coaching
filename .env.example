# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://mhp:mhp@localhost:5432/mhp

# Local email capture (Mailpit never sends to real recipients)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=MHP Coaching <contact@mhp-coaching.ch>

# Hosted email via Resend. When set, contact and lead mail go through Resend.
RESEND_API_KEY=
RESEND_FROM=MHP Coaching <contact@mhp-coaching.ch>

# Local and automated tests use the deterministic fake provider.
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=local-fake-payment-secret

# Stripe test-mode placeholders only. Never use live credentials locally or in previews.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Used server-side for canonical and alternate metadata.
SITE_URL=http://localhost:3000

# HTTP basic auth for the staff booking list. Leave empty to keep staff routes closed.
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me-locally
