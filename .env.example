# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://mhp:mhp@localhost:5432/mhp
# Hosted Neon on Vercel may inject NEON_DATABASE_URL instead; the app accepts that fallback.
# Hosted migrations prefer NEON_DATABASE_URL_UNPOOLED when the integration provides it.

# Local email capture (Mailpit never sends to real recipients)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=MHP Coaching <contact@mhp-coaching.ch>

# Hosted email via Resend. When an API key is set, all transactional mail goes
# through Resend. The connected Vercel marketplace key
# EMAILS_RESEND_RESEND_API_KEY is preferred when present; portable names and
# other marketplace prefixes remain supported.
RESEND_API_KEY=
RESEND_FROM=MHP Coaching <contact@mhp-coaching.ch>
# RESEND_EMAIL_DOMAIN=mhp-coaching.ch

# Local and automated tests use the deterministic fake provider.
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=local-fake-payment-secret

# Stripe test-mode placeholders only. Never use live credentials locally or in previews.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Protects /api/cron/rooms (Vercel Cron sends Authorization: Bearer).
CRON_SECRET=local-cron-secret

# Used server-side for canonical and alternate metadata.
SITE_URL=http://localhost:3000

# First administrator. Never commit a real password. Create it with:
# BOOTSTRAP_ADMIN_EMAIL=you@example.com BOOTSTRAP_ADMIN_PASSWORD='at-least-12-chars' pnpm db:bootstrap-admin
# The command refuses to run when an enabled admin already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=MHP
BOOTSTRAP_ADMIN_LOCALE=fr

# AES-256-GCM key for owner-only room booking notes. 64 hex characters (32 bytes).
# Required to create or read private notes. Never commit a production key.
# Local example only — generate a unique key per environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_NOTE_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Optional previous key used only to decrypt notes written before rotation.
# ROOM_NOTE_ENCRYPTION_KEY_PREVIOUS=
# ROOM_NOTE_ENCRYPTION_KEY_VERSION=1
# ROOM_NOTE_ENCRYPTION_PREVIOUS_VERSION=
